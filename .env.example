# Frontend API Base URL
VITE_BACKEND_URL=http://localhost:5000/api

# MongoDB Atlas Connection String
# Replace with your actual credentials from MongoDB Atlas Dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Technovision Organizer Admin Key
TECHNOVISION_ADMIN_KEY=flux2026

# Optional: Set to true only for offline development fallback
ALLOW_LOCAL_FALLBACK=false

